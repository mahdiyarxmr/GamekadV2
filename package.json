{
  "name": "gamekad",
  "version": "1.0.0",
  "private": true,
  "description": "پلتفرم باشگاه بازی و رویدادهای حضوری گیم‌کاد / رکاد",
  "scripts": {
    "dev:server": "pnpm --filter server start:dev",
    "dev:client": "pnpm --filter client dev",
    "dev": "concurrently \"pnpm run dev:server\" \"pnpm run dev:client\"",
    "build:server": "pnpm --filter server build",
    "build:client": "pnpm --filter client build",
    "build": "pnpm run build:server && pnpm run build:client",
    "seed": "pnpm --filter server seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
